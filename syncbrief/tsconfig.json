{
  "extends": "plasmo/templates/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "~*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".plasmo/index.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}